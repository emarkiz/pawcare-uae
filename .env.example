# ─── Supabase ───────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── Stripe (Payments) ──────────────────────────────────────────────────────
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# ─── Google (Maps, OAuth) ───────────────────────────────────────────────────
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ─── Apple Sign In ──────────────────────────────────────────────────────────
EXPO_PUBLIC_APPLE_CLIENT_ID=your.apple.service.id

# ─── Push Notifications (Expo) ────────────────────────────────────────────
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# ─── Delivery Partners ──────────────────────────────────────────────────────
FETCHR_API_KEY=your-fetchr-api-key
ARAMEX_API_KEY=your-aramex-api-key

# ─── Platform Settings ──────────────────────────────────────────────────────
EXPO_PUBLIC_PLATFORM_COMMISSION_RATE=0.15
EXPO_PUBLIC_VAT_RATE=0.05
EXPO_PUBLIC_PLATFORM_TRN=100123456700003

# ─── Environment ────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=development
